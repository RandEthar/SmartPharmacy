<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdoutLogEnabled is normally left off because it writes on every request, but a startup
        crash produces no other output: the process dies before any logger is configured, so IIS
        can only report 500.30. Turn it back off once the deployment starts cleanly.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\SmartPharmacy.PL.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
